{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm --prefix frontend run build",
  "outputDirectory": "frontend/dist",
  "framework": null,

  "functions": {
    "api/index.py": {
      "runtime": "@vercel/python",
      "maxDuration": 10
    }
  },

  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
